# 复制这个文件为 .env，然后填真实值。.env 不要提交到 git，也不要发给任何AI。

# ========== 应用基础配置 ==========
# PYTHON_ENV 不由 pydantic-settings 读取，它通过 os.getenv 单独控制（默认 dev），不要加到 .env 里
APP_NAME=企业客服Agent

# ========== LLM 配置 ==========
LLM_API_KEY=your_key_here
LLM_BASE_URL=
LLM_MODEL_NAME=gpt-4o-mini
# LLM 调用超时（秒）和最大重试次数
LLM_TIMEOUT=60
LLM_MAX_RETRIES=2

# ========== Embedding 配置（V3 RAG）==========
# 注意：EMBEDDING_API_KEY 留空时会复用 LLM_API_KEY（见 src/retrieval/rag.py）。
# 如果 chat 与 embedding 不是同一家服务，必须把下面两项也填上，否则 build_kb.py 会 401。
# 下面默认值是智谱；用阿里云百炼则换成
#   EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_MODEL_NAME=embedding-3
EMBEDDING_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
EMBEDDING_API_KEY=
# 输出维度：256/512/1024/2048，默认 1024
# EMBEDDING_DIMENSIONS=1024
# 相似度阈值：低于此值视为不相关，0 关闭过滤
# EMBEDDING_SIMILARITY_THRESHOLD=0.25
# 熔断器配置（V7）：连续 N 次失败后短路，等待 M 秒后恢复
EMBEDDING_FAILURE_THRESHOLD=3
EMBEDDING_RECOVERY_TIMEOUT=30

# ========== ChromaDB 存储路径（V8 增强）==========
# 默认 chroma_db/ 在项目根目录。Docker 部署时改为卷路径（如 /data/chroma_db）
# 避免容器重启后向量库数据丢失。
# CHROMA_PATH=chroma_db

# ========== PostgreSQL 配置（V5 持久化）==========
# 与 docker-compose.yml 的端口映射一致（容器 5432 → 宿主机 5432）。
# 若你用 WSL2 / 本机自建 PostgreSQL 且端口是 5433，再改成 5433。
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_demo
# 滑动窗口大小：每次请求最多携带最近 N 条历史消息
MAX_HISTORY_MESSAGES=10

# ========== JWT 认证（V7）==========
# dev 环境留空即用进程内随机密钥（进程重启后 token 失效，重新登录即可）；
# 生产环境必须显式设置 >=32 位随机串，否则服务拒绝启动。
# 生成方式：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========== 服务器配置 ==========
HOST=0.0.0.0
PORT=8000

# ========== 日志配置 ==========
# LOG_LEVEL=info    # debug / info / warning / error
